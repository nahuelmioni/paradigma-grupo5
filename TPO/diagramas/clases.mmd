---
config:
  layout: elk
---
classDiagram
    direction TB

    class Partida {
        -CANTIDAD_TRAMPOLINES: int = 4$
        -jugador1: Jugador
        -jugador2: Jugador
        -consola: Consola
        +Partida()
        +main(args: String[])$ void
        +jugar() void
        -prepararJugador(jugador: Jugador) void
        -jugarTurno(tirador: Jugador, rival: Jugador) void
        -rebotar(tirador: Jugador, rival: Jugador) void
        -describir(resultado: Resultado, enTuTablero: boolean) String
        -crearFlota()$ List~Barco~
    }
    class Consola {
        -scanner: Scanner
        +Consola()
        +pedirTexto(mensaje: String) String
        +pedirCoordenada(mensaje: String) Coordenada
        +pedirOrientacion(mensaje: String) boolean
        +mostrar(texto: String) void
        +mostrar(izquierda: String, derecha: String) void
        +limpiarPantalla() void
        +esperarEnter(mensaje: String) void
        +cerrar() void
    }
    class Jugador {
        -nombre: String
        -tablero: Tablero
        +Jugador(nombre: String)
        +getNombre() String
        +getTablero() Tablero
        +perdio() boolean
    }
    class Tablero {
        +TAMANIO: int = 10$
        -casillas: Casilla[][]
        -flota: List~Barco~
        +Tablero()
        +colocarBarco(barco: Barco, inicio: Coordenada, horizontal: boolean) boolean
        +colocarTrampolin(casilla: Coordenada) boolean
        -hayLugar(inicio: Coordenada, largo: int, horizontal: boolean) boolean
        +yaRecibioBomba(casilla: Coordenada) boolean
        +recibirBomba(casilla: Coordenada) Resultado
        +casillaAlAzarSinBomba() Coordenada
        +flotaHundida() boolean
        +dibujar(esPropio: boolean) String
    }
    class Casilla {
        -elemento: ElementoMarino
        -recibioBomba: boolean
        ~Casilla()
        ~estaLibre() boolean
        ~ponerElemento(elemento: ElementoMarino) void
        ~yaRecibioBomba() boolean
        +recibirBomba() Resultado
        ~getSimbolo(esPropio: boolean) char
    }
    class Coordenada {
        -fila: int
        -columna: int
        +Coordenada(fila: int, columna: int)
        +Coordenada(texto: String)
        -leerFila(texto: String)$ int
        -leerColumna(texto: String)$ int
        +getFila() int
        +getColumna() int
        +toString() String
    }
    class Bombardeable {
        <<interface>>
        +recibirBomba() Resultado
    }
    class ElementoMarino {
        <<abstract>>
        -simboloSinBomba: char
        -simboloConBomba: char
        #ElementoMarino(simboloSinBomba: char, simboloConBomba: char)
        +recibirBomba()* Resultado
        +getSimbolo(recibioBomba: boolean) char
        +ocupaLugar() boolean
    }
    class Agua {
        +Agua()
        +recibirBomba() Resultado
        +ocupaLugar() boolean
    }
    class Barco {
        -nombre: String
        -largo: int
        -impactos: int
        +Barco(nombre: String, largo: int)
        +getNombre() String
        +getLargo() int
        +estaHundido() boolean
        +recibirBomba() Resultado
        +compareTo(otro: Barco) int
        +toString() String
    }
    class Trampolin {
        +Trampolin()
        +recibirBomba() Resultado
    }
    class Resultado {
        <<enumeration>>
        AGUA
        TOCADO
        HUNDIDO
        REBOTE
    }
    class CoordenadaInvalidaException {
        +CoordenadaInvalidaException(texto: String)
    }
    class Comparable~Barco~ {
        <<interface>>
    }
    class Exception

    Partida "1" *--> "2" Jugador
    Partida "1" *--> "1" Consola
    Jugador "1" *--> "1" Tablero
    Tablero "1" *--> "100" Casilla
    Tablero "1" o--> "4" Barco : flota
    Casilla "1..*" --> "1" ElementoMarino : elemento

    Bombardeable <|.. Casilla
    Bombardeable <|.. ElementoMarino
    ElementoMarino <|-- Agua
    ElementoMarino <|-- Barco
    ElementoMarino <|-- Trampolin
    Comparable~Barco~ <|.. Barco
    Exception <|-- CoordenadaInvalidaException

    Bombardeable ..> Resultado : devuelve
    Tablero ..> Coordenada : usa
    Consola ..> Coordenada : crea
    Coordenada ..> CoordenadaInvalidaException : lanza

    class Comparable~Barco~:::java
    class Exception:::java
    classDef java fill:#eeeeee,stroke:#888888,color:#444444
