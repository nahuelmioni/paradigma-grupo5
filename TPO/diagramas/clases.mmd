    %% Punto de entrada
    Main ..> VentanaPrincipal : crea

    %% Interfaz grafica
    JFrame <|-- VentanaPrincipal
    JPanel <|-- PanelInicio
    JPanel <|-- PanelPreparacion
    JPanel <|-- PanelJuego
    VentanaPrincipal ..> PanelInicio : crea
    VentanaPrincipal ..> PanelPreparacion : crea
    VentanaPrincipal ..> PanelJuego : crea
    PanelInicio --> "1" VentanaPrincipal : ventana
    PanelInicio ..> Jugador : crea
    PanelInicio "1" *-- "1" ArchivoJugadores : archivo
    PanelInicio ..> HiloCargaJugadores : crea y start()
    PanelInicio ..> TareaGuardarJugador : crea
    PanelPreparacion --> "1" VentanaPrincipal : ventana
    PanelPreparacion --> "2" Jugador : jugador1, jugador2
    PanelJuego "1" *-- "1" Partida : partida
    PanelJuego ..> CasillaYaAtacadaException : catch

    %% Modelo
    Partida "1" o-- "2" Jugador : jugador1, jugador2
    Partida ..> CasillaYaAtacadaException : throws
    Jugador "1" *-- "1" Tablero : tablero
    Tablero "1" *-- "100" Casilla : casillas
    Tablero "1" *-- "1" FlotaImp : flota
    Tablero ..> Coordenada : usa
    Casilla "1..*" --> "1" ElementoMarino : elemento
    ElementoMarino ..> Resultado : crea
    Exception <|-- CasillaYaAtacadaException
    Exception <|-- JugadorExistenteException
    ArchivoJugadores ..> JugadorExistenteException : throws

    %% Hilos
    Thread <|-- HiloCargaJugadores
    Runnable <|.. TareaGuardarJugador
    HiloCargaJugadores --> "1" ArchivoJugadores : archivo
    HiloCargaJugadores --> "1" PanelInicio : panel
    TareaGuardarJugador --> "1" ArchivoJugadores : archivo
    TareaGuardarJugador --> "1" PanelInicio : panel

    %% Elementos marinos
    ElementoMarino <|-- Agua
    ElementoMarino <|-- Barco
    ElementoMarino <|-- Trampolin
    Comparable <|.. Barco : T = Barco

    %% TDA flota
    FlotaInterfaz <|.. FlotaImp
    FlotaImp "1" o-- "0..4" Barco : barcos
