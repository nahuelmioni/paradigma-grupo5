    "Agua" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#f5e3cc" CELLPADDING="6"><B>Agua</B></TD></TR></TABLE>>];
    "Barco" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#f5e3cc" CELLPADDING="6"><B>Barco</B></TD></TR></TABLE>>];
    "Trampolin" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#f5e3cc" CELLPADDING="6"><B>Trampolin</B></TD></TR></TABLE>>];
  }
  subgraph "cluster_TDAS" { label=<<B>TDAs</B>>; fontsize=13; style="rounded,filled"; fillcolor="#f6f3fc"; color="#9aa9b8"; margin=14;
    "FlotaInterfaz" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e3dcf5" CELLPADDING="6"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>FlotaInterfaz</B></TD></TR></TABLE>>];
    "FlotaImp" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e3dcf5" CELLPADDING="6"><B>FlotaImp</B></TD></TR></TABLE>>];
  }
  "JFrame" -> "VentanaPrincipal" [dir=back, arrowtail=empty, weight=3];
  "JPanel" -> "PanelInicio" [dir=back, arrowtail=empty, weight=3];
  "JPanel" -> "PanelPreparacion" [dir=back, arrowtail=empty, weight=3];
  "JPanel" -> "PanelJuego" [dir=back, arrowtail=empty, weight=3];
