    "Tablero" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Tablero</B></TD></TR></TABLE>>];
    "Casilla" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Casilla</B></TD></TR></TABLE>>];
    "Coordenada" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Coordenada</B></TD></TR></TABLE>>];
    "Resultado" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Resultado</B></TD></TR></TABLE>>];
    "ArchivoJugadores" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>ArchivoJugadores</B></TD></TR></TABLE>>];
    "CasillaYaAtacadaException" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>CasillaYaAtacadaException</B></TD></TR></TABLE>>];
