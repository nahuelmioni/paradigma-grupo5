  "Thread" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e6e6e6" CELLPADDING="6"><B>Thread</B></TD></TR></TABLE>>];
  "Runnable" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e6e6e6" CELLPADDING="6"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>Runnable</B></TD></TR></TABLE>>];
  "Exception" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e6e6e6" CELLPADDING="6"><B>Exception</B></TD></TR></TABLE>>];
  "Comparable<T>" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e6e6e6" CELLPADDING="6"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>Comparable&lt;T&gt;</B></TD></TR></TABLE>>];
  subgraph "cluster_RAIZ" { label=<<B>TPO.BATALLA_NAVAL</B>>; fontsize=13; style="rounded,filled"; fillcolor="#ffffff"; color="#9aa9b8"; margin=14;
    "Main" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e9eef3" CELLPADDING="6"><B>Main</B></TD></TR></TABLE>>];
  }
  subgraph "cluster_INTERFAZ" { label=<<B>INTERFAZ</B>>; fontsize=13; style="rounded,filled"; fillcolor="#f1f6fc"; color="#9aa9b8"; margin=14;
    "VentanaPrincipal" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d9e8f6" CELLPADDING="6"><B>VentanaPrincipal</B></TD></TR></TABLE>>];
    "PanelInicio" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d9e8f6" CELLPADDING="6"><B>PanelInicio</B></TD></TR></TABLE>>];
    "PanelPreparacion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d9e8f6" CELLPADDING="6"><B>PanelPreparacion</B></TD></TR></TABLE>>];
    "PanelJuego" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d9e8f6" CELLPADDING="6"><B>PanelJuego</B></TD></TR></TABLE>>];
    "HiloCargaJugadores" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d9e8f6" CELLPADDING="6"><B>HiloCargaJugadores</B></TD></TR></TABLE>>];
    "TareaGuardarJugador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d9e8f6" CELLPADDING="6"><B>TareaGuardarJugador</B></TD></TR></TABLE>>];
  }
  subgraph "cluster_CLASES" { label=<<B>CLASES</B>>; fontsize=13; style="rounded,filled"; fillcolor="#f2f8f4"; color="#9aa9b8"; margin=14;
