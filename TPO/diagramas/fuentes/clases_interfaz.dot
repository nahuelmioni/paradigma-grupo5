  "PanelInicio" -> "ArchivoJugadores" [dir=both, arrowtail=diamond, arrowhead=vee, label=" archivo ", taillabel="1", headlabel="1", weight=2];
  "Partida" -> "Jugador" [dir=both, arrowtail=odiamond, arrowhead=vee, label=" jugador1, jugador2 ", taillabel="1", headlabel="2", weight=2];
