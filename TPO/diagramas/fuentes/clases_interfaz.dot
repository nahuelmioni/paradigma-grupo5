digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=16, labelloc=t, labeljust=l, label=<<B>Interfaz gráfica, archivo e hilos</B>>, nodesep=0.45, ranksep=0.75, pad=0.3, newrank=true, splines=spline, bgcolor="white"];
  node [shape=plaintext, fontname="Helvetica", fontsize=11, margin=0];
  edge [fontname="Helvetica", fontsize=10, color="#4a5866", fontcolor="#33414e", arrowsize=0.9, labelfontsize=10, labelfontcolor="#1c5d99", labeldistance=1.9, labelangle=28];
  "JFrame" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e6e6e6" CELLPADDING="6"><B>JFrame</B></TD></TR></TABLE>>];
  "JPanel" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e6e6e6" CELLPADDING="6"><B>JPanel</B></TD></TR></TABLE>>];
  "Thread" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e6e6e6" CELLPADDING="6"><B>Thread</B></TD></TR></TABLE>>];
  "Runnable" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e6e6e6" CELLPADDING="6"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>Runnable</B></TD></TR></TABLE>>];
  "Exception" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e6e6e6" CELLPADDING="6"><B>Exception</B></TD></TR></TABLE>>];
  subgraph "cluster_RAIZ" { label=<<B>TPO.BATALLA_NAVAL</B>>; fontsize=13; style="rounded,filled"; fillcolor="#ffffff"; color="#9aa9b8"; margin=14;
    "Main" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e9eef3" CELLPADDING="6"><B>Main</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ main(args: String[]): void</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph "cluster_INTERFAZ" { label=<<B>INTERFAZ</B>>; fontsize=13; style="rounded,filled"; fillcolor="#f1f6fc"; color="#9aa9b8"; margin=14;
    "VentanaPrincipal" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d9e8f6" CELLPADDING="6"><B>VentanaPrincipal</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ VentanaPrincipal()<BR ALIGN="LEFT"/>+ iniciarPreparacion(jugador1: Jugador, jugador2: Jugador): void<BR ALIGN="LEFT"/>+ iniciarJuego(jugador1: Jugador, jugador2: Jugador): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "PanelInicio" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d9e8f6" CELLPADDING="6"><B>PanelInicio</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- listaJugador1: JComboBox&lt;String&gt;<BR ALIGN="LEFT"/>- listaJugador2: JComboBox&lt;String&gt;<BR ALIGN="LEFT"/>- botonCrearJugador: JButton<BR ALIGN="LEFT"/>- botonComenzar: JButton<BR ALIGN="LEFT"/>- etiquetaEstado: JLabel<BR ALIGN="LEFT"/>- ventana: VentanaPrincipal<BR ALIGN="LEFT"/>- archivo: ArchivoJugadores<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ PanelInicio(ventana: VentanaPrincipal)<BR ALIGN="LEFT"/>~ mostrarJugadores(nombres: ArrayList&lt;String&gt;): void<BR ALIGN="LEFT"/>~ jugadorCreado(nombre: String): void<BR ALIGN="LEFT"/>~ mostrarError(mensaje: String): void<BR ALIGN="LEFT"/>~ terminarCarga(): void<BR ALIGN="LEFT"/>~ terminarGuardado(): void<BR ALIGN="LEFT"/>- crearJugador(): void<BR ALIGN="LEFT"/>- comenzarPartida(): void<BR ALIGN="LEFT"/>- actualizarEstado(): void<BR ALIGN="LEFT"/>- bloquearControles(bloquear: boolean): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "PanelPreparacion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d9e8f6" CELLPADDING="6"><B>PanelPreparacion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ventana: VentanaPrincipal<BR ALIGN="LEFT"/>- jugador1: Jugador<BR ALIGN="LEFT"/>- jugador2: Jugador<BR ALIGN="LEFT"/>- jugadorActual: Jugador<BR ALIGN="LEFT"/>- indiceBarco: int<BR ALIGN="LEFT"/>- trampolinesColocados: int<BR ALIGN="LEFT"/>- horizontal: boolean<BR ALIGN="LEFT"/>- botonesTablero: JButton[][]<BR ALIGN="LEFT"/>- etiquetaJugador: JLabel<BR ALIGN="LEFT"/>- etiquetaInstruccion: JLabel<BR ALIGN="LEFT"/>- botonOrientacion: JButton<BR ALIGN="LEFT"/>- nombresBarcos: String[]<BR ALIGN="LEFT"/>- largosBarcos: int[]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ PanelPreparacion(ventana: VentanaPrincipal, jugador1: Jugador, jugador2: Jugador)<BR ALIGN="LEFT"/>- mostrarPantallaEspera(): void<BR ALIGN="LEFT"/>- mostrarPantallaPreparacion(): void<BR ALIGN="LEFT"/>- crearInterfaz(): void<BR ALIGN="LEFT"/>- cambiarOrientacion(): void<BR ALIGN="LEFT"/>- seleccionarCasilla(fila: int, columna: int): void<BR ALIGN="LEFT"/>- colocarBarco(coordenada: Coordenada): void<BR ALIGN="LEFT"/>- marcarBarco(coordenada: Coordenada, largo: int, horizontal: boolean): void<BR ALIGN="LEFT"/>- colocarTrampolin(coordenada: Coordenada): void<BR ALIGN="LEFT"/>- actualizarInformacion(): void<BR ALIGN="LEFT"/>- terminarPreparacionJugador(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "PanelJuego" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d9e8f6" CELLPADDING="6"><B>PanelJuego</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- partida: Partida<BR ALIGN="LEFT"/>- etiquetaTurno: JLabel<BR ALIGN="LEFT"/>- etiquetaResultado: JLabel<BR ALIGN="LEFT"/>- tableroPropio: JTextArea<BR ALIGN="LEFT"/>- botonesDisparo: JButton[][]<BR ALIGN="LEFT"/>- resumenUltimoTurno: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ PanelJuego(jugador1: Jugador, jugador2: Jugador)<BR ALIGN="LEFT"/>- mostrarPantallaEspera(): void<BR ALIGN="LEFT"/>- mostrarPantallaJuego(): void<BR ALIGN="LEFT"/>- crearInterfaz(): void<BR ALIGN="LEFT"/>- crearTableroPropio(panelCentral: JPanel): void<BR ALIGN="LEFT"/>- crearBotoneraDisparo(panelCentral: JPanel): void<BR ALIGN="LEFT"/>- disparar(fila: int, columna: int): void<BR ALIGN="LEFT"/>- actualizarBotoneraRival(): void<BR ALIGN="LEFT"/>- actualizarPantalla(): void<BR ALIGN="LEFT"/>- actualizarTableros(): void<BR ALIGN="LEFT"/>- terminarPartida(): void<BR ALIGN="LEFT"/>- desactivarDisparos(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "HiloCargaJugadores" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d9e8f6" CELLPADDING="6"><B>HiloCargaJugadores</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- archivo: ArchivoJugadores<BR ALIGN="LEFT"/>- panel: PanelInicio<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ HiloCargaJugadores(archivo: ArchivoJugadores, panel: PanelInicio)<BR ALIGN="LEFT"/>+ run(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "TareaGuardarJugador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d9e8f6" CELLPADDING="6"><B>TareaGuardarJugador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- archivo: ArchivoJugadores<BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- panel: PanelInicio<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ TareaGuardarJugador(archivo: ArchivoJugadores, nombre: String, panel: PanelInicio)<BR ALIGN="LEFT"/>+ run(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph "cluster_CLASES" { label=<<B>CLASES</B>>; fontsize=13; style="rounded,filled"; fillcolor="#f2f8f4"; color="#9aa9b8"; margin=14;
    "ArchivoJugadores" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>ArchivoJugadores</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ ARCHIVO_POR_DEFECTO: String = &quot;jugadores.txt&quot;</U><BR ALIGN="LEFT"/>- ruta: Path<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ArchivoJugadores()<BR ALIGN="LEFT"/>+ ArchivoJugadores(nombreArchivo: String)<BR ALIGN="LEFT"/>+ leerJugadores(): ArrayList&lt;String&gt;<BR ALIGN="LEFT"/>+ agregarJugador(nombre: String): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "JugadorExistenteException" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>JugadorExistenteException</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ JugadorExistenteException(nombre: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Jugador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Jugador</B></TD></TR></TABLE>>];
    "Partida" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Partida</B></TD></TR></TABLE>>];
  }
  "JFrame" -> "VentanaPrincipal" [dir=back, arrowtail=empty, weight=3];
  "JPanel" -> "PanelInicio" [dir=back, arrowtail=empty, weight=3];
  "JPanel" -> "PanelPreparacion" [dir=back, arrowtail=empty, weight=3];
  "JPanel" -> "PanelJuego" [dir=back, arrowtail=empty, weight=3];
