  "HiloCargaJugadores" -> "PanelInicio" [arrowhead=vee, label=" panel ", taillabel="", headlabel="1", constraint=false];
  "TareaGuardarJugador" -> "PanelInicio" [arrowhead=vee, label=" panel ", taillabel="", headlabel="1", constraint=false];
