digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=16, labelloc=t, labeljust=l, label=<<B>Lógica del juego: paquetes CLASES, ELEMENTOS_MARINOS y TDAs</B>>, nodesep=0.45, ranksep=0.75, pad=0.3, newrank=true, splines=spline, bgcolor="white"];
  node [shape=plaintext, fontname="Helvetica", fontsize=11, margin=0];
  edge [fontname="Helvetica", fontsize=10, color="#4a5866", fontcolor="#33414e", arrowsize=0.9, labelfontsize=10, labelfontcolor="#1c5d99", labeldistance=1.9, labelangle=28];
  "Exception" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e6e6e6" CELLPADDING="6"><B>Exception</B></TD></TR></TABLE>>];
  "Comparable<T>" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e6e6e6" CELLPADDING="6"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>Comparable&lt;T&gt;</B></TD></TR></TABLE>>];
  subgraph "cluster_CLASES" { label=<<B>CLASES</B>>; fontsize=13; style="rounded,filled"; fillcolor="#f2f8f4"; color="#9aa9b8"; margin=14;
    "Partida" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Partida</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- jugador1: Jugador<BR ALIGN="LEFT"/>- jugador2: Jugador<BR ALIGN="LEFT"/>- jugadorActual: Jugador<BR ALIGN="LEFT"/>- random: Random<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Partida(jugador1: Jugador, jugador2: Jugador)<BR ALIGN="LEFT"/>+ getJugadorActual(): Jugador<BR ALIGN="LEFT"/>+ getRivalActual(): Jugador<BR ALIGN="LEFT"/>+ puedeDisparar(coordenada: Coordenada): boolean<BR ALIGN="LEFT"/>+ disparar(coordenada: Coordenada): Resultado<BR ALIGN="LEFT"/>+ disparar(fila: int, columna: int): Resultado<BR ALIGN="LEFT"/>- rebotar(tirador: Jugador, rival: Jugador): void<BR ALIGN="LEFT"/>- generarCoordenadaAleatoria(tablero: Tablero): Coordenada<BR ALIGN="LEFT"/>+ cambiarTurno(): void<BR ALIGN="LEFT"/>+ termino(): boolean<BR ALIGN="LEFT"/>+ getGanador(): Jugador<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Jugador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Jugador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre: String<BR ALIGN="LEFT"/>- tablero: Tablero<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Jugador(nombre: String)<BR ALIGN="LEFT"/>+ getNombre(): String<BR ALIGN="LEFT"/>+ getTablero(): Tablero<BR ALIGN="LEFT"/>+ perdio(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Tablero" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Tablero</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ TAMANIO: int = 10</U><BR ALIGN="LEFT"/>- casillas: Casilla[][]<BR ALIGN="LEFT"/>- flota: FlotaImp<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Tablero()<BR ALIGN="LEFT"/>+ colocarBarco(barco: Barco, inicio: Coordenada, horizontal: boolean): boolean<BR ALIGN="LEFT"/>+ colocarTrampolin(coordenada: Coordenada): boolean<BR ALIGN="LEFT"/>- hayLugar(inicio: Coordenada, largo: int, horizontal: boolean): boolean<BR ALIGN="LEFT"/>+ yaRecibioBomba(coordenada: Coordenada): boolean<BR ALIGN="LEFT"/>+ recibirBomba(coordenada: Coordenada): Resultado<BR ALIGN="LEFT"/>+ getSimbolo(coordenada: Coordenada, esPropio: boolean): char<BR ALIGN="LEFT"/>+ flotaHundida(): boolean<BR ALIGN="LEFT"/>+ dibujar(esPropio: boolean): String<BR ALIGN="LEFT"/>+ getBarcosOrdenados(): ArrayList&lt;Barco&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Casilla" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Casilla</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- elemento: ElementoMarino<BR ALIGN="LEFT"/>- recibioBomba: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Casilla()<BR ALIGN="LEFT"/>+ estaLibre(): boolean<BR ALIGN="LEFT"/>+ ponerElemento(elemento: ElementoMarino): void<BR ALIGN="LEFT"/>+ yaRecibioBomba(): boolean<BR ALIGN="LEFT"/>+ recibirBomba(): Resultado<BR ALIGN="LEFT"/>+ getSimbolo(esPropio: boolean): char<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Coordenada" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Coordenada</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fila: int<BR ALIGN="LEFT"/>- columna: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Coordenada(fila: int, columna: int)<BR ALIGN="LEFT"/>+ Coordenada(fila: char, columna: int)<BR ALIGN="LEFT"/><U>+ desdeTexto(texto: String): Coordenada</U><BR ALIGN="LEFT"/>+ getFila(): int<BR ALIGN="LEFT"/>+ getColumna(): int<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Resultado" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Resultado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ AGUA: int = 0</U><BR ALIGN="LEFT"/><U>+ TOCADO: int = 1</U><BR ALIGN="LEFT"/><U>+ HUNDIDO: int = 2</U><BR ALIGN="LEFT"/><U>+ TRAMPOLIN: int = 3</U><BR ALIGN="LEFT"/>- tipo: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Resultado(tipo: int)<BR ALIGN="LEFT"/>+ getTipo(): int<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "CasillaYaAtacadaException" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>CasillaYaAtacadaException</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ CasillaYaAtacadaException(mensaje: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph "cluster_ELEMENTOS" { label=<<B>ELEMENTOS_MARINOS</B>>; fontsize=13; style="rounded,filled"; fillcolor="#fcf6ee"; color="#9aa9b8"; margin=14;
    "ElementoMarino" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#f5e3cc" CELLPADDING="6"><B><I>ElementoMarino</I></B><BR/><FONT POINT-SIZE="10">{abstract}</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ocupaLugar: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># ElementoMarino(ocupaLugar: boolean)<BR ALIGN="LEFT"/>+ ocupaLugar(): boolean<BR ALIGN="LEFT"/><I>+ recibirBomba(): Resultado</I><BR ALIGN="LEFT"/><I>+ getSimbolo(recibioBomba: boolean): char</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Agua" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#f5e3cc" CELLPADDING="6"><B>Agua</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Agua()<BR ALIGN="LEFT"/>+ recibirBomba(): Resultado<BR ALIGN="LEFT"/>+ getSimbolo(recibioBomba: boolean): char<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Barco" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#f5e3cc" CELLPADDING="6"><B>Barco</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre: String<BR ALIGN="LEFT"/>- largo: int<BR ALIGN="LEFT"/>- impactos: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Barco(nombre: String, largo: int)<BR ALIGN="LEFT"/>+ getNombre(): String<BR ALIGN="LEFT"/>+ getLargo(): int<BR ALIGN="LEFT"/>+ estaHundido(): boolean<BR ALIGN="LEFT"/>+ recibirBomba(): Resultado<BR ALIGN="LEFT"/>+ getSimbolo(recibioBomba: boolean): char<BR ALIGN="LEFT"/>+ compareTo(otroBarco: Barco): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Trampolin" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#f5e3cc" CELLPADDING="6"><B>Trampolin</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Trampolin()<BR ALIGN="LEFT"/>+ recibirBomba(): Resultado<BR ALIGN="LEFT"/>+ getSimbolo(recibioBomba: boolean): char<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph "cluster_TDAS" { label=<<B>TDAs</B>>; fontsize=13; style="rounded,filled"; fillcolor="#f6f3fc"; color="#9aa9b8"; margin=14;
    "FlotaInterfaz" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e3dcf5" CELLPADDING="6"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>FlotaInterfaz</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregarBarco(barco: Barco): boolean<BR ALIGN="LEFT"/>+ estaCompleta(): boolean<BR ALIGN="LEFT"/>+ estaHundida(): boolean<BR ALIGN="LEFT"/>+ cantidadBarcos(): int<BR ALIGN="LEFT"/>+ getBarcosOrdenados(): ArrayList&lt;Barco&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "FlotaImp" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#e3dcf5" CELLPADDING="6"><B>FlotaImp</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- barcos: ArrayList&lt;Barco&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ FlotaImp()<BR ALIGN="LEFT"/>+ agregarBarco(barco: Barco): boolean<BR ALIGN="LEFT"/>+ estaCompleta(): boolean<BR ALIGN="LEFT"/>+ estaHundida(): boolean<BR ALIGN="LEFT"/>+ cantidadBarcos(): int<BR ALIGN="LEFT"/>+ getBarcosOrdenados(): ArrayList&lt;Barco&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  "ElementoMarino" -> "Agua" [dir=back, arrowtail=empty, weight=3];
  "ElementoMarino" -> "Barco" [dir=back, arrowtail=empty, weight=3];
  "ElementoMarino" -> "Trampolin" [dir=back, arrowtail=empty, weight=3];
  "Comparable<T>" -> "Barco" [dir=back, arrowtail=empty, style=dashed, label="T = Barco", weight=3];
  "FlotaInterfaz" -> "FlotaImp" [dir=back, arrowtail=empty, style=dashed, weight=3];
  "Exception" -> "CasillaYaAtacadaException" [dir=back, arrowtail=empty, weight=3];
  "Jugador" -> "Tablero" [dir=both, arrowtail=diamond, arrowhead=vee, label=" tablero ", taillabel="1", headlabel="1", weight=2];
  "Tablero" -> "Casilla" [dir=both, arrowtail=diamond, arrowhead=vee, label=" casillas ", taillabel="1", headlabel="100", weight=2];
  "Tablero" -> "FlotaImp" [dir=both, arrowtail=diamond, arrowhead=vee, label=" flota ", taillabel="1", headlabel="1", weight=2];
  "Partida" -> "Jugador" [dir=both, arrowtail=odiamond, arrowhead=vee, label=" jugador1, jugador2 ", taillabel="1", headlabel="2", weight=2];
  "FlotaImp" -> "Barco" [dir=both, arrowtail=odiamond, arrowhead=vee, label=" barcos ", taillabel="1", headlabel="0..4", weight=2];
  "Casilla" -> "ElementoMarino" [arrowhead=vee, label=" elemento ", taillabel="1..*", headlabel="1"];
  "Partida" -> "CasillaYaAtacadaException" [style=dashed, arrowhead=vee, label=" «throws» ", fontcolor="#6a7682"];
  "ElementoMarino" -> "Resultado" [style=dashed, arrowhead=vee, label=" «create» ", fontcolor="#6a7682"];
  "Tablero" -> "Coordenada" [style=dashed, arrowhead=vee, label=" «use» ", fontcolor="#6a7682"];
}