    "Tablero" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Tablero</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ TAMANIO: int = 10</U><BR ALIGN="LEFT"/>- casillas: Casilla[][]<BR ALIGN="LEFT"/>- flota: FlotaImp<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Tablero()<BR ALIGN="LEFT"/>+ colocarBarco(barco: Barco, inicio: Coordenada, horizontal: boolean): boolean<BR ALIGN="LEFT"/>+ colocarTrampolin(coordenada: Coordenada): boolean<BR ALIGN="LEFT"/>- hayLugar(inicio: Coordenada, largo: int, horizontal: boolean): boolean<BR ALIGN="LEFT"/>+ yaRecibioBomba(coordenada: Coordenada): boolean<BR ALIGN="LEFT"/>+ recibirBomba(coordenada: Coordenada): Resultado<BR ALIGN="LEFT"/>+ getSimbolo(coordenada: Coordenada, esPropio: boolean): char<BR ALIGN="LEFT"/>+ flotaHundida(): boolean<BR ALIGN="LEFT"/>+ dibujar(esPropio: boolean): String<BR ALIGN="LEFT"/>+ getBarcosOrdenados(): ArrayList&lt;Barco&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Casilla" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Casilla</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- elemento: ElementoMarino<BR ALIGN="LEFT"/>- recibioBomba: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Casilla()<BR ALIGN="LEFT"/>+ estaLibre(): boolean<BR ALIGN="LEFT"/>+ ponerElemento(elemento: ElementoMarino): void<BR ALIGN="LEFT"/>+ yaRecibioBomba(): boolean<BR ALIGN="LEFT"/>+ recibirBomba(): Resultado<BR ALIGN="LEFT"/>+ getSimbolo(esPropio: boolean): char<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Coordenada" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Coordenada</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fila: int<BR ALIGN="LEFT"/>- columna: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Coordenada(fila: int, columna: int)<BR ALIGN="LEFT"/>+ Coordenada(fila: char, columna: int)<BR ALIGN="LEFT"/><U>+ desdeTexto(texto: String): Coordenada</U><BR ALIGN="LEFT"/>+ getFila(): int<BR ALIGN="LEFT"/>+ getColumna(): int<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
