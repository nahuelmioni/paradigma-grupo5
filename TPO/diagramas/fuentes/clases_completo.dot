digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=16, labelloc=t, labeljust=l, label=<<B>Batalla Naval con Trampolines · diagrama de clases completo</B>>, nodesep=0.45, ranksep=0.75, pad=0.3, newrank=true, splines=spline, bgcolor="white"];
