  }
  subgraph "cluster_CLASES" { label=<<B>CLASES</B>>; fontsize=13; style="rounded,filled"; fillcolor="#f2f8f4"; color="#9aa9b8"; margin=14;
    "Partida" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#4a5866"><TR><TD BGCOLOR="#d7ecdf" CELLPADDING="6"><B>Partida</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- jugador1: Jugador<BR ALIGN="LEFT"/>- jugador2: Jugador<BR ALIGN="LEFT"/>- jugadorActual: Jugador<BR ALIGN="LEFT"/>- random: Random<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Partida(jugador1: Jugador, jugador2: Jugador)<BR ALIGN="LEFT"/>+ getJugadorActual(): Jugador<BR ALIGN="LEFT"/>+ getRivalActual(): Jugador<BR ALIGN="LEFT"/>+ puedeDisparar(coordenada: Coordenada): boolean<BR ALIGN="LEFT"/>+ disparar(coordenada: Coordenada): Resultado<BR ALIGN="LEFT"/>+ disparar(fila: int, columna: int): Resultado<BR ALIGN="LEFT"/>- rebotar(tirador: Jugador, rival: Jugador): void<BR ALIGN="LEFT"/>- generarCoordenadaAleatoria(tablero: Tablero): Coordenada<BR ALIGN="LEFT"/>+ cambiarTurno(): void<BR ALIGN="LEFT"/>+ termino(): boolean<BR ALIGN="LEFT"/>+ getGanador(): Jugador<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
