sequenceDiagram
    autonumber
    actor U as Usuario
    participant PI as :PanelInicio
    participant T as tarea :TareaGuardarJugador
    participant H as hiloGuardado :Thread
    participant A as :ArchivoJugadores

    U->>PI: click en "Crear jugador nuevo"
    PI->>U: JOptionPane pide el nombre
    U-->>PI: nombre
    PI->>PI: bloquearControles(true)
    PI->>T: new TareaGuardarJugador(archivo, nombre, this)
    PI->>H: new Thread(tarea)
    PI->>H: start()
    Note over PI: El hilo de la ventana queda libre y la pantalla no se congela

    H->>T: run()
    T->>A: agregarJugador(nombre)
    Note over A: synchronized + try-with-resources sobre jugadores.txt

    alt el nombre ya existe
        A--)T: throw JugadorExistenteException
        T--)PI: invokeLater(mostrarError(mensaje))
    else nombre nuevo
        A-->>T: se escribió en el archivo
        T--)PI: invokeLater(jugadorCreado(nombre))
    end

    T--)PI: finally: invokeLater(terminarGuardado())
    PI->>PI: bloquearControles(false)
